# ── Database (Turso / libSQL) ─────────────────────────────────────────────
# Required on Vercel. Leave empty to use a local file:local.db for development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Admin authentication ──────────────────────────────────────────────────
# Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@shotechsolutions.com
ADMIN_PASSWORD=ChangeMe123!

# ── Cloudinary ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site URL (used by sitemap.xml) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shotechsolutions.com
