# ── Database (Turso / libSQL) ─────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Admin authentication ──────────────────────────────────────────────────
# Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@shotechsolutions.com
# Preferred in production: generate with `npm run auth:hash -- "your-password"`
ADMIN_PASSWORD_HASH=
# Legacy/dev fallback only:
ADMIN_PASSWORD=

# ── Cloudinary ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shotechsolutions.com
